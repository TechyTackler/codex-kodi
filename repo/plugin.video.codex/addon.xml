<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.codex"
       name="CODEX IPTV"
       version="0.1.0"
       provider-name="TechyTackler">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Xtream-compatible IPTV client for Kodi.</summary>
        <description lang="en_GB">CODEX IPTV connects to an authorised Xtream-compatible provider and provides Live TV browsing and playback inside Kodi.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/TechyTackler/codex-kodi</source>
    </extension>
</addon>
