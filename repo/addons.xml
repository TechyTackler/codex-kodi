<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="repository.codex"
       name="CODEX Repository"
       version="1.0.0"
       provider-name="TechyTackler">
    <extension point="xbmc.addon.repository" name="CODEX Repository">
        <dir>
            <info compressed="false">https://techytackler.github.io/codex-kodi/repo/addons.xml</info>
            <checksum>https://techytackler.github.io/codex-kodi/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://techytackler.github.io/codex-kodi/repo/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Official repository for CODEX Kodi add-ons.</summary>
        <description lang="en_GB">Install and update CODEX Kodi add-ons.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/TechyTackler/codex-kodi</source>
    </extension>
</addon>
<addon id="plugin.video.codex"
       name="CODEX IPTV"
       version="0.4.0"
       provider-name="TechyTackler">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Xtream-compatible IPTV client for Kodi.</summary>
        <description lang="en_GB">CODEX IPTV connects to an authorised Xtream-compatible provider and provides Live TV browsing and playback inside Kodi.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/TechyTackler/codex-kodi</source>
    </extension>
</addon>
</addons>